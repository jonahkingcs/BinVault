{
  "name": "binwise",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop asset library for video editors",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "build": "npm run typecheck && electron-vite build",
    "package:win": "npm run build && node -e \"require('electron')\" && electron-builder --win --dir"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
